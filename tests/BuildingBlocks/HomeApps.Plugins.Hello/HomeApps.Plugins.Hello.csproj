<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The smallest real plugin: the kit's tests run it, and the web app's plugin host loads its UI as a fixture
    (docs/plugins.md). Everything in one project on purpose; a real plugin keeps the four-layer split.
  -->
  <PropertyGroup>
    <IsTestProject>false</IsTestProject>
    <!-- The UI's sources and node_modules; its build lands in wwwroot/ui (ui/vite.config.ts). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);ui/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\BuildingBlocks\HomeApps.Plugins.Hosting\HomeApps.Plugins.Hosting.csproj" />
  </ItemGroup>

</Project>
