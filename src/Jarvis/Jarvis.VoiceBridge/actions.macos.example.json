// Example --actions file for a Mac (docs/devices.md). Each field of the input reaches the command as JARVIS_<FIELD>,
// never inside the command text. "confirm" defaults to true: JARVIS asks first, unless "Nie pytaj" is set for it.
[
  {
    "name": "say",
    "description": "Mówi zdanie na głos z głośnika tego Maca.",
    "input": { "type": "object", "properties": { "text": { "type": "string" } }, "required": ["text"] },
    "run": "say -v Zosia \"$JARVIS_TEXT\"",
    "confirm": false
  },
  {
    "name": "notify",
    "description": "Pokazuje powiadomienie na tym Macu.",
    "input": { "type": "object", "properties": { "text": { "type": "string" } }, "required": ["text"] },
    "run": "osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title \"JARVIS\"' -e 'end run' \"$JARVIS_TEXT\"",
    "confirm": false
  },
  {
    "name": "open_url",
    "description": "Otwiera adres w przeglądarce na tym Macu.",
    "input": { "type": "object", "properties": { "url": { "type": "string" } }, "required": ["url"] },
    "run": "case \"$JARVIS_URL\" in https://*) open \"$JARVIS_URL\";; *) echo 'Tylko adresy https://' >&2; exit 1;; esac"
  },
  {
    "name": "battery",
    "description": "Podaje stan baterii tego Maca.",
    "run": "pmset -g batt | tail -n 1",
    "readOnly": true
  }
]
