{
  "name": "@home-apps/vue",
  "version": "3.0.0",
  "description": "Vue 3 composables and the HomeApps look for HomeMix add-ons (docs/homemix.md)",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/Qwerex56/HomeApps.git", "directory": "src/Web/homemix/vue" },
  "homepage": "https://github.com/Qwerex56/HomeApps/blob/master/docs/homemix-authoring.md",
  "keywords": ["homeapps", "homemix", "add-on"],
  "publishConfig": { "access": "public" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
