<Project>
  <!--
    Settings for every project in the repository. src/ and tests/ add their own Directory.Build.props on top
    (analyzers and test packages); a csproj can still override anything here.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
