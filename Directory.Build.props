<Project>
  <!--
    Settings for every project in the repository. src/ and tests/ add their own Directory.Build.props on top
    (analyzers and test packages); a csproj can still override anything here.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>2.1.0</Version>
    <!-- The kit is also packed for plugins outside this repository (scripts/pack.sh, docs/plugins.md). -->
    <Authors>HomeApps</Authors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
