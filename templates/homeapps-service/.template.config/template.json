{
  "$schema": "http://json.schemastore.org/template",
  "author": "HomeApps",
  "classifications": [ "HomeApps", "Web", "Service" ],
  "identity": "HomeApps.Templates.Service",
  "name": "HomeApps service",
  "shortName": "homeapps-service",
  "description": "A HomeApps microservice: Domain, Application, Infrastructure and Api projects plus Domain, Application and integration test projects, wired to the shared kit. Run it from the repository root.",
  "tags": { "language": "C#", "type": "project" },
  "sourceName": "ServiceName",
  "preferNameDirectory": false,
  "symbols": {
    "serviceLower": {
      "type": "generated",
      "generator": "casing",
      "parameters": { "source": "name", "toLower": true },
      "replaces": "servicelower"
    },
    "sample": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Add the Echo sample: an aggregate, a command, a query, a domain event mapped to an integration message, a consumer and tests."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!sample)",
          "exclude": [
            "**/Echoes/**",
            "**/IEchoRepository.cs",
            "src/Contracts/**",
            "tests/ServiceName/ServiceName.IntegrationTests/EchoFlowTests.cs"
          ]
        },
        {
          "condition": "(sample)",
          "exclude": [ "tests/ServiceName/ServiceName.Domain.Tests/PlaceholderTests.cs", "tests/ServiceName/ServiceName.Application.Tests/PlaceholderTests.cs" ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    { "path": "src/ServiceName/ServiceName.Domain/ServiceName.Domain.csproj" },
    { "path": "src/ServiceName/ServiceName.Application/ServiceName.Application.csproj" },
    { "path": "src/ServiceName/ServiceName.Infrastructure/ServiceName.Infrastructure.csproj" },
    { "path": "src/ServiceName/ServiceName.Api/ServiceName.Api.csproj" },
    { "path": "tests/ServiceName/ServiceName.Domain.Tests/ServiceName.Domain.Tests.csproj" },
    { "path": "tests/ServiceName/ServiceName.Application.Tests/ServiceName.Application.Tests.csproj" },
    { "path": "tests/ServiceName/ServiceName.IntegrationTests/ServiceName.IntegrationTests.csproj" }
  ],
  "postActions": [
    {
      "description": "Add the service projects to the solution.",
      "manualInstructions": [ { "text": "Add the projects under src/ServiceName to the solution." } ],
      "actionId": "D396686C-DE0E-4DE6-906D-291CD29FC5DE",
      "args": { "primaryOutputIndexes": "0;1;2;3", "solutionFolder": "src" },
      "continueOnError": true
    },
    {
      "description": "Add the test projects to the solution.",
      "manualInstructions": [ { "text": "Add the projects under tests/ServiceName to the solution." } ],
      "actionId": "D396686C-DE0E-4DE6-906D-291CD29FC5DE",
      "args": { "primaryOutputIndexes": "4;5;6", "solutionFolder": "tests" },
      "continueOnError": true
    }
  ]
}
