# Copy to .env for docker compose in development (docs/development.md). Every value has a working default; set only
# what you want to change. Never commit .env. Production uses .env.prod.example instead.

# `docker compose up -d` without -f and --profile: the dev file with every service in a container.
COMPOSE_FILE=compose.dev.yaml
COMPOSE_PROFILES=services

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# The address everything is served at. Plugins' own compose files (HomeApps.Todo, HomeApps.Chat) need it.
HOMEAPPS_DOMAIN=app.localhost

# Plugins of this instance, e.g. todo,chat: the web app (vite), HomeMix and JARVIS read it (docs/development.md).
HOMEAPPS_PLUGINS=

# A-30: the first Owner's email. On an empty database Auth sends this address an invitation (see Mailpit).
AUTH_BOOTSTRAP_EMAIL=

# Google sign-in, only for the auth container. From Rider use dotnet user-secrets instead.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# D10: members per household, guests and inactive accounts included (households container).
HOUSEHOLDS_MAX_MEMBERS=100

# Web Push keys for the notifications container (docs/notifications.md). Empty: a temporary pair on every start, so
# browsers must turn notifications on again after a restart. scripts/generate-vapid-keys.sh prints lasting ones.
NOTIFICATIONS_VAPID_PUBLIC_KEY=
NOTIFICATIONS_VAPID_PRIVATE_KEY=

# JARVIS: without the token he answers that he is switched off (`claude setup-token`, docs/jarvis.md).
JARVIS_CLAUDE_CODE_OAUTH_TOKEN=
JARVIS_CLAUDE_MODEL=
# Speaches (compose.voice.yaml) for JARVIS's ears and voice; the default is Speaches on this Mac.
# JARVIS_VOICE_URL=http://host.docker.internal:8000

# Service clients' secrets. Leave them out in development: compose gives Auth and Devices/JARVIS the same defaults.
# Set one only to test with your own value; compose passes it to both sides.
# JARVIS_CLIENT_SECRET=
# DEVICES_CLIENT_SECRET=
# HOMEMIX_CLIENT_SECRET=

# The Chat plugin (HomeApps.Chat's compose.yaml) signs photo and film links with this: openssl rand -base64 48
# CHAT_MEDIA_SIGNING_KEY=
