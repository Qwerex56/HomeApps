# Copy to .env for docker compose (compose.dev.yaml). Every value has a working default for development;
# set only what you want to change. Never commit .env.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# A-30: the first Owner's email. On an empty database Auth sends this address an invitation (see Mailpit).
AUTH_BOOTSTRAP_EMAIL=

# Google sign-in, only for the auth container (profile "services"). From Rider use dotnet user-secrets instead.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# D10: members per household, guests and inactive accounts included (households container).
HOUSEHOLDS_MAX_MEMBERS=100
