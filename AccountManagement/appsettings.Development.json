{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DbConnectionConfig": {
    "HostName": "YourDbHost",
    "Port": "5432",
    "DbName": "YourDatabaseNameDev",
    "Username": "YourDbUsername",
    "Password": "YourDbPassword"
  },
  "SeedUser": {
    "Name": "YourAdminName",
    "Email": "admin@example.com",
    "Password": "YourAdminPassword",
    "Role": "SystemOwner"
  },
  "JwtOptions": {
    "Issuer": "YourIssuer",
    "Audience": "YourAudience",
    "SecretKey": "YourSecretKey"
  },
  "RabbitMqOptions": {
    "Host": "rabbitmq",
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest"
  }
}
