# Copy to .env next to compose.prod.yaml and fill in every "required" value. Never commit .env.

# required: the public address. With open ports DNS must point here and ports 80/443 must reach this machine;
# behind a Cloudflare Tunnel the tunnel's public hostname must be this address (docs/deployment.md).
HOMEAPPS_DOMAIN=home-apps.dev

# Cloudflare Tunnel (CGNAT, no open ports): the overlay compose.tunnel.yaml. With COMPOSE_FILE set, plain
# `docker compose ...` uses both files.
# COMPOSE_FILE=compose.prod.yaml:compose.tunnel.yaml
# required with the tunnel: the token after --token in the dashboard's install command. A secret.
CLOUDFLARE_TUNNEL_TOKEN=

# Open ports only: the Let's Encrypt account address (optional).
ACME_EMAIL=
# For a first try without hitting Let's Encrypt limits use the staging CA (browsers will not trust it):
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

POSTGRES_USER=homeapps
# required: a long random value, e.g. openssl rand -base64 32
POSTGRES_PASSWORD=

RABBITMQ_USER=homeapps
# required
RABBITMQ_PASSWORD=

# required: the first Owner (D9). On an empty database Auth sends this address an invitation.
AUTH_BOOTSTRAP_EMAIL=

# Google sign-in (optional). Authorized redirect URI in Google Cloud: https://<HOMEAPPS_DOMAIN>/auth/external/google/callback
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# required: the mail server Auth sends invitations, password resets and notices through.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=homeapps@home-apps.dev

# D10: members per household, guests and inactive accounts included.
HOUSEHOLDS_MAX_MEMBERS=100

# Plugins of this instance, comma-separated ids (docs/plugins.md), e.g. todo. Each runs from its own compose file.
HOMEAPPS_PLUGINS=
