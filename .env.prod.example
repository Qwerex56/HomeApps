# Copy to .env next to compose.prod.yaml and fill in every "required" value. Never commit .env.

# required: the public address. With open ports DNS must point here and ports 80/443 must reach this machine;
# behind a Cloudflare Tunnel the tunnel's public hostname must be this address (docs/deployment.md).
HOMEAPPS_DOMAIN=home-apps.dev

# Cloudflare Tunnel (CGNAT, no open ports): the overlay compose.tunnel.yaml. With COMPOSE_FILE set, plain
# `docker compose ...` uses both files.
# COMPOSE_FILE=compose.prod.yaml:compose.tunnel.yaml
# required with the tunnel: the token after --token in the dashboard's install command. A secret.
CLOUDFLARE_TUNNEL_TOKEN=

# Open ports only: the Let's Encrypt account address (optional).
ACME_EMAIL=
# For a first try without hitting Let's Encrypt limits use the staging CA (browsers will not trust it):
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

POSTGRES_USER=homeapps
# required: a long random value, e.g. openssl rand -base64 32
POSTGRES_PASSWORD=

RABBITMQ_USER=homeapps
# required
RABBITMQ_PASSWORD=

# required: the first Owner (D9). On an empty database Auth sends this address an invitation.
AUTH_BOOTSTRAP_EMAIL=

# Google sign-in (optional). Authorized redirect URI in Google Cloud: https://<HOMEAPPS_DOMAIN>/auth/external/google/callback
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# required: the mail server Auth sends invitations, password resets and notices through.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=homeapps@home-apps.dev

# D10: members per household, guests and inactive accounts included.
HOUSEHOLDS_MAX_MEMBERS=100

# required: Web Push keys (docs/notifications.md). Run scripts/generate-vapid-keys.sh once and paste both lines.
# Keep them: new keys mean every device has to turn notifications on again. The private key is a secret.
NOTIFICATIONS_VAPID_PUBLIC_KEY=
NOTIFICATIONS_VAPID_PRIVATE_KEY=
# How push services (Google, Mozilla, Apple) can reach you about this instance: mailto: or https. Default: the site.
# NOTIFICATIONS_VAPID_SUBJECT=mailto:you@example.com

# Plugins of this instance, comma-separated ids (docs/plugins.md), e.g. todo. Each runs from its own compose file.
HOMEAPPS_PLUGINS=

# JARVIS (docs/jarvis.md).
# required: the secret JARVIS asks Auth for delegated tokens with, e.g. openssl rand -base64 32
JARVIS_CLIENT_SECRET=
# The owner's Claude subscription for JARVIS's own answers: run `claude setup-token` and paste the token. A secret.
# Empty: the JARVIS page and @Jarvis answer that he is switched off; Claude Code can still connect to the gateway.
JARVIS_CLAUDE_CODE_OAUTH_TOKEN=

# HomeMix add-ons (docs/homemix.md). false: nobody adds or updates add-ons; installed ones keep working.
# HOMEMIX_UPLOADS_ENABLED=true
# Optional GitHub token (no scopes needed), only to raise GitHub's limit of 60 anonymous requests an hour.
# HOMEMIX_GITHUB_TOKEN=
# The store's index (addons.json with GitHub repository links). Unset: the HomeApps repository's homemix/store/addons.json;
# empty: the store shows only the official add-ons that come with HomeMix.
# HOMEMIX_STORE_INDEX=

# Chat plugin (docs/plugin-chat.md): signs the links to photos and films, at least 32 characters.
# Generate once: openssl rand -base64 48
# CHAT_MEDIA_SIGNING_KEY=
