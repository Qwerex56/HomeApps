{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet tool restore)",
      "Bash(dotnet ef migrations add:*)",
      "Bash(npm run type-check)",
      "Bash(npm run test:run:*)",
      "Bash(npm run build)",
      "Bash(npx vitest run:*)",
      "Bash(npx eslint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(gh auth status)",
      "Bash(gh pr view:*)",
      "Bash(python3 .claude/scripts/token-usage.py:*)",
      "Bash(agy:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin master:*)",
      "Bash(git push origin HEAD:master:*)",
      "Bash(git reset --hard:*)",
      "Edit(.env)",
      "Read(.env)"
    ]
  },
  "hooks": {"PreToolUse": [{"matcher": "Bash", "hooks": [{"type": "command", "command": "python3 -I ~/.agent-hub/scripts/guard_bash.py"}]}]}
}
